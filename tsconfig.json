{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    // Ignore TypeScript strict errors
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,

    // Allow emitting even with errors
    "noEmitOnError": false
  },
  "include": ["src"]
}
